# ============================================================================
# r_orphan_cleanup.conf
# Centralized configuration for the R orphan worker cleanup system
# Managed by BIOME-CALC deployment
# ============================================================================

# ── Email Utility ─────────────────────────────────────────────
SEND_EMAIL_SCRIPT="${BIOME_CONF}/script/send_email.sh"

# ── SMTP Settings ─────────────────────────────────────────────
SMTP_HOST="${SMTP_HOST}"
SMTP_PORT="${SMTP_PORT}"
SENDER_EMAIL="${SENDER_EMAIL}"
DNS_SERVERS="${SMTP_DNS_SERVERS}"

# ── User Email Domain(s) ──────────────────────────────────────
# Legacy single-domain fallback
MAIL_DOMAIN="${MAIL_DOMAIN}"
# Active multi-domain list (space-separated). If set, resolve_user_email()
# returns a CSV "user@d1,user@d2" when no override exists in user_email_map.txt
MAIL_DOMAINS_USER="${MAIL_DOMAINS_USER}"

# ── User e-mail from Active Directory ─────────────────────────
# resolve_user_email_source() order: user_email_map.txt -> AD `mail`
# attribute -> MAIL_DOMAINS_USER pattern. The AD step runs only when both
# URI and base DN are set; it binds with the host keytab (GSSAPI) using a
# private credential cache and falls back on any error or timeout.
# A domain URI (ldap://<ad domain>) is expanded to its DCs via the
# _ldap._tcp SRV record; optional USER_MAIL_AD_MAX_DCS (default 3).
USER_MAIL_AD_URI="${USER_MAIL_AD_URI}"
USER_MAIL_AD_BASE_DN="${USER_MAIL_AD_BASE_DN}"
# Seconds, applied to kinit and to ldapsearch separately
USER_MAIL_AD_TIMEOUT="${USER_MAIL_AD_TIMEOUT}"

# ── Admin Recipients ──────────────────────────────────────────
# Set to the recipients list deployed during setup
ADMIN_EMAIL="file://${BIOME_CONF}/conf/admin_recipients.txt"

# ── Log Paths ─────────────────────────────────────────────────
# --- Paths and Directories ---
LOG_DIR="/var/log/biome-log/r_orphan_cleanup"
LOG_FILE="${LOG_DIR}/cleanup.log"
NOTIFY_DIR="${LOG_DIR}/notifications"

# ── Thresholds ────────────────────────────────────────────────
MIN_AGE_SECONDS=120
MAX_LOG_SIZE=$((10 * 1024 * 1024))
KILL_TIMEOUT="${KILL_TIMEOUT}"

# ── Process Patterns to Monitor ───────────────────────────────
ORPHAN_PATTERNS=(
    "parallel:::.workRSOCK|parallel::PSOCK"
    "parallel:::.slaveRSOCK|parallel::PSOCK (legacy)"
    "parallelly:::.workRSOCK|future::multisession"
    "parallelly:::|future::parallelly"
    "callr::r_bg|callr::r_bg"
    "callr::r_session|callr::r_session"
    "BiocParallel|BiocParallel"
    "clustermq|clustermq"
    "batchtools|batchtools"
    "snowSOCK\\|snowRSOCK|snow (legacy)"
    "python.*tensorflow|tensorflow (Python)"
    "python.*keras|keras (Python)"
    "python.*earthengine|rgee/earthengine (Python)"
    "python.*torch|PyTorch (Python)"
    "python.*ee_utils|rgee (Python)"
    "python.*reticulate|reticulate (Python generico)"
    "gdal|GDAL subprocess"
    "ogr2ogr|OGR subprocess"
    "Rscript.*worker|Rscript worker (generico)"
)

# ── Excluded Patterns (Must NOT Kill) ─────────────────────────
EXCLUDE_PATTERNS=(
    "jupyter"
    "code-server"
    "rstudio-server"
    "rserver"
    "rsession"
    # v4.6: C++ compiler chain spawned by nimble/TMB/Rcpp compilation
    # compileNimble() → R CMD SHLIB → make → g++ → cc1plus
    # These are LEGITIMATE children of rsession, not orphans.
    # Killing these aborts 16h+ MCMC compilation and causes "R Session Aborted".
    "cc1plus"
    "cc1"
    "g++"
    "c++"
    "R CMD SHLIB"
    "R CMD INSTALL"
)
